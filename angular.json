{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "vestra": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "i18n": {
        "sourceLocale": {
          "code": "en-US",
          "subPath": ""
        },
        "locales": {
          "es-419": {
            "translation": "src/locale/messages.es-419.xlf"
          },
          "de": {
            "translation": "src/locale/messages.de.xlf"
          },
          "fr": {
            "translation": "src/locale/messages.fr.xlf"
          },
          "ru": {
            "translation": "src/locale/messages.ru.xlf"
          },
          "zh-Hans": {
            "translation": "src/locale/messages.zh-Hans.xlf"
          }
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/vestra",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["@angular/localize/init"],
            "tsConfig": "tsconfig.app.json",
            "assets": ["src/assets"],
            "styles": ["src/styles.css"],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": ["localhost", "127.0.0.1"]
            },
            "ssr": {
              "entry": "src/server.ts"
            },
            "i18nMissingTranslation": "error"
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": true
              },
              "outputHashing": "all",
              "localize": true
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            },
            "es-419": {
              "localize": ["es-419"]
            },
            "de": {
              "localize": ["de"]
            },
            "fr": {
              "localize": ["fr"]
            },
            "ru": {
              "localize": ["ru"]
            },
            "zh-Hans": {
              "localize": ["zh-Hans"]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "vestra:build:production"
            },
            "development": {
              "buildTarget": "vestra:build:development"
            },
            "es-419": {
              "buildTarget": "vestra:build:development,es-419"
            },
            "de": {
              "buildTarget": "vestra:build:development,de"
            },
            "fr": {
              "buildTarget": "vestra:build:development,fr"
            },
            "ru": {
              "buildTarget": "vestra:build:development,ru"
            },
            "zh-Hans": {
              "buildTarget": "vestra:build:development,zh-Hans"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "vestra:build"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "40bb9d6f-4f01-4e55-9553-3bcbabc465ee"
  }
}
